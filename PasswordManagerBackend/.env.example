# Server Configuration
PORT=4002
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/passwordmanager

# JWT Authentication Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Password Encryption Secret Key (32-character key for AES-256)
SECRET_KEY=your_32_char_encryption_secret_key!

# Allowed CORS Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
